---
import BaseLayout from "../layouts/BaseLayout.astro";

const profile = {
  name: "Kęstutis Skrebė",
  role: "Developer (Laravel / Java / Linux)",
  location: "Vilnius, Lithuania",
  email: "kestutis.julius@gmail.com",
  github: "https://github.com/Kestutisjulius",
  linkedin: "https://www.linkedin.com/in/k-s-992b5a217",
  phone: "+370 613 77 180",
  cvPdf: "/cv.pdf",
};

const skills = [
  "Laravel / PHP",
  "Java (learning/practice)",
  "REST API / Integrations",
  "Linux administration (Debian/Ubuntu)",
  "Git / GitHub",
];

const experience = [
  {
    title: "IT Consultant",
    org: "BNM Finance",
    period: "2022-10 – 2025-11",
    desc: "Laravel sprendimai, verslo sistemų integracijos (RIVILE-GAMA), Linux administravimas, legacy sprendimų priežiūra.",
  },
  {
    title: "Owner",
    org: 'JSC “KUR MES”, Vilnius',
    period: "2014-12 – 2021-01",
    desc: "Prepress, maketavimas ir paruošimas spaudai, PDF tvarkymas ir kokybės kontrolė.",
  },
];

const education = [
  {
    title: "Software Engineering (Professional Bachelor of Computing)",
    org: "Vilniaus kolegija",
    period: "2024-09 – now",
  },
  {
    title: "PHP Programmer",
    org: "Baltic Institute of Technology",
    period: "2022-03 – 2022-08",
  },
  {
    title: "Java Programmer",
    org: "UAB Akademia SDA",
    period: "2020-12 – 2021-08",
  },
];
---

<BaseLayout
  title={`${profile.name} | CV ir Portfolio`}
  description="Kęstutis Skrebė — CV, patirtis ir projektai."
>
  <main class="page">
    <header class="hero">
      <p class="eyebrow">CV + Portfolio</p>
      <h1>{profile.name}</h1>
      <p class="lead">{profile.role}</p>
      <p class="meta">{profile.location}</p>

      <div class="actions">
        <a class="btn primary" href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
        <a class="btn ghost" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="btn ghost" href={`mailto:${profile.email}`}>El. paštas</a>
        <a class="btn ghost" href={profile.cvPdf} target="_blank" rel="noreferrer">CV (PDF)</a>
      </div>

      <p class="meta" style="margin-top: 0.75rem;">
        Tel.: <a href={`tel:${profile.phone.replaceAll(" ", "")}`}>{profile.phone}</a>
        &nbsp;•&nbsp;
        {profile.email}
      </p>
    </header>

    <section class="panel">
      <h2>Įgūdžiai</h2>
      <ul class="chips">
        {skills.map((s) => <li>{s}</li>)}
      </ul>
    </section>

    <section class="panel">
      <h2>Patirtis</h2>
      {experience.map((job) => (
        <div class="timeline-item">
          <p class="timeline-title">{job.title}</p>
          <p class="timeline-meta">{job.org} | {job.period}</p>
          <p>{job.desc}</p>
        </div>
      ))}
    </section>

    <section class="panel">
      <h2>Išsilavinimas</h2>
      {education.map((e) => (
        <div class="timeline-item">
          <p class="timeline-title">{e.title}</p>
          <p class="timeline-meta">{e.org} | {e.period}</p>
        </div>
      ))}
    </section>
  </main>
</BaseLayout>
